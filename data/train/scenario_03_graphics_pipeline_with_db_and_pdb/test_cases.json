{
  "scenario_name": "Graphics Pipeline with DB and PDB Resolution",
  "description": "A graphics rendering scenario with Vertex Shader and Pixel Shader, featuring vertex buffers, index buffer, constant buffer views, shader resource views (buffers and textures), samplers, render targets, depth/stencil, and PDB-resolved shader source. Based on GlobalID=3854 resource bindings.",
  "capture_db": "capture_db/capture.db",
  "test_cases": [
    {
      "id": "s3_tc01",
      "tool": "db-get-event-resource",
      "description": "Retrieve all bound resources for a graphics draw event (GlobalID=3854). Expects VB, IB, CBV, SRV Buffer, SRV Texture, Sampler, RTV, Depth, Stencil.",
